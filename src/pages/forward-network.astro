---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";

const verticals = [
  {
    label: "Customer Success & CX",
    count: 4,
    companies: [
      { name: "Meridian CX", role: "VP Customer Success", size: "Mid-Market", outcome: "42% deflection rate improvement" },
      { name: "Arrowfield Solutions", role: "Head of Support", size: "Enterprise", outcome: "CSAT from 3.8 → 4.6 in 6 weeks" },
      { name: "Hartwell Group", role: "Director, CX Operations", size: "SMB", outcome: "Agent handle time down 31%" },
      { name: "Crestline B2B", role: "Support Operations Lead", size: "Mid-Market", outcome: "Tier-1 automation at 67%" },
    ],
  },
  {
    label: "Revenue Operations & Sales Tech",
    count: 3,
    companies: [
      { name: "Vantage RevOps", role: "Head of RevOps", size: "Mid-Market", outcome: "Deal desk response time cut by half" },
      { name: "Ironbridge Software", role: "VP Operations", size: "SMB", outcome: "Renewal support fully automated" },
      { name: "Northpoint SaaS", role: "Customer Operations Manager", size: "Mid-Market", outcome: "Onboarding CSAT up 28 points" },
    ],
  },
  {
    label: "HR Tech & People Operations",
    count: 2,
    companies: [
      { name: "Clearfield HR", role: "Director of Client Services", size: "Mid-Market", outcome: "Benefits inquiry deflection at 58%" },
      { name: "Landon Workforce", role: "VP Customer Support", size: "Enterprise", outcome: "Ticket volume down 44% in Q1" },
    ],
  },
  {
    label: "FinTech & Financial Operations",
    count: 3,
    companies: [
      { name: "Summit Payments", role: "Head of Client Support", size: "Mid-Market", outcome: "Dispute resolution time down 37%" },
      { name: "Folio Financial", role: "Operations Director", size: "SMB", outcome: "AI triage handles 71% of inbound" },
      { name: "Bridgewater Finops", role: "VP Client Success", size: "Enterprise", outcome: "FTE capacity freed: 2.1 roles equiv." },
    ],
  },
  {
    label: "Professional Services",
    count: 2,
    companies: [
      { name: "Apex Consulting Group", role: "Head of Delivery Ops", size: "Mid-Market", outcome: "Project status queries fully deflected" },
      { name: "Thornwick Advisory", role: "Operations Lead", size: "SMB", outcome: "Client portal adoption up 3x" },
    ],
  },
  {
    label: "Legal Tech",
    count: 1,
    companies: [
      { name: "Lexford Platforms", role: "Director of Support", size: "Mid-Market", outcome: "Matter update queries automated at 61%" },
    ],
  },
  {
    label: "Dev Tools & Engineering Platforms",
    count: 2,
    companies: [
      { name: "Codebridge Labs", role: "Head of Developer Success", size: "SMB", outcome: "Docs deflection rate 53% in 30 days" },
      { name: "Stackform Inc.", role: "VP Customer Engineering", size: "Mid-Market", outcome: "Support-to-product feedback loop rebuilt" },
    ],
  },
  {
    label: "Healthcare & MedTech",
    count: 2,
    companies: [
      { name: "Meridian MedOps", role: "Director, Client Operations", size: "Enterprise", outcome: "Compliance query handling automated" },
      { name: "Carepath Solutions", role: "VP Support", size: "Mid-Market", outcome: "Patient billing deflection at 48%" },
    ],
  },
];
---

<Layout
  title="The Forward Network: Work with Companies That Get It"
  description="A verified directory of Forward graduates, organized by industry. Stop evaluating vendors still stuck in AI curiosity. Work with teams who've already made the leap."
>
  <Nav />

  <main class="pt-[57px]">

    <!-- ─── HERO ────────────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden border-b border-stone-200 bg-stone-50">
      <div class="absolute inset-0 grid-bg pointer-events-none"></div>

      <div class="relative mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
        <div class="max-w-3xl">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-stone-400">
            Forward / The Network
          </p>

          <h1 class="font-display mt-6 text-5xl font-semibold leading-[1.05] tracking-tight text-stone-950 sm:text-6xl lg:text-[4.25rem]">
            Your next vendor should already be Forward.
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-500">
            You've done the work. You've moved from AI curiosity to operational impact. Why spend your next vendor evaluation cycle on companies still running inconclusive pilots? The Forward Network is a verified directory of graduates who've made the same leap you have — organized by industry, searchable by outcome.
          </p>

          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a
              href="#directory"
              class="inline-flex items-center justify-center gap-2 border border-stone-950 bg-stone-950 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-stone-800"
            >
              Browse the directory
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a
              href="#access"
              class="inline-flex items-center justify-center gap-2 border border-stone-300 bg-white px-6 py-3.5 text-sm font-semibold text-stone-700 transition-colors hover:bg-stone-50"
            >
              Request access
            </a>
          </div>
        </div>

        <!-- Stat strip -->
        <div class="mt-16 flex flex-wrap gap-10">
          {[
            { value: "19", label: "Verified graduates" },
            { value: "8", label: "Industry verticals" },
            { value: "100%", label: "Documented outcomes" },
            { value: "Gated", label: "Graduates only" },
          ].map(({ value, label }) => (
            <div>
              <div class="font-display text-3xl font-bold text-stone-950">{value}</div>
              <div class="mt-1 font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-stone-400">{label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>


    <!-- ─── THE PREMISE ──────────────────────────────────────────────────── -->
    <section class="border-b border-stone-200 px-5 py-24 lg:px-8">
      <div class="mx-auto max-w-7xl">

        <div class="grid gap-16 lg:grid-cols-2 lg:gap-24">
          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-stone-400">
              The problem with vendor search
            </p>
            <h2 class="font-display mt-5 text-4xl font-semibold leading-[1.1] tracking-tight text-stone-950 lg:text-5xl">
              Most vendor cycles waste everyone's time.
            </h2>
            <p class="mt-6 text-base leading-8 text-stone-500">
              When you start a new vendor evaluation, you're usually choosing between two bad options: trust a sales deck, or run a pilot that takes months to produce a result you already knew.
            </p>
            <p class="mt-4 text-base leading-8 text-stone-500">
              Forward graduates skip that friction — on both sides. When you're the buyer, you already know the vendor has built operational discipline around AI, measured outcomes, and cross-functional execution. When you're the vendor, your prospect already speaks your language.
            </p>
            <p class="mt-4 text-base leading-8 text-stone-500">
              That's the network. Shared fluency. Faster trust. Less wasted time.
            </p>
          </div>

          <div class="space-y-px">
            {[
              {
                label: "Without the network",
                items: [
                  "3–6 weeks of vendor demos and slides",
                  "Pilots that produce inconclusive data",
                  "No shared baseline for what 'good' looks like",
                  "Trust built from scratch every time",
                ],
                dark: false,
              },
              {
                label: "With the Forward Network",
                items: [
                  "Verified operational discipline before first call",
                  "Documented outcomes you can reference directly",
                  "Shared language around AI, metrics, and execution",
                  "Introductions from people who've already done the work",
                ],
                dark: true,
              },
            ].map(({ label, items, dark }) => (
              <div class={`p-8 ${dark ? "bg-stone-950" : "bg-stone-100"}`}>
                <p class={`font-mono text-[10px] font-bold uppercase tracking-[0.2em] ${dark ? "text-stone-500" : "text-stone-400"}`}>
                  {label}
                </p>
                <ul class="mt-5 space-y-3">
                  {items.map((item) => (
                    <li class={`flex items-start gap-3 text-sm leading-6 ${dark ? "text-stone-300" : "text-stone-500"}`}>
                      <span class={`font-mono text-xs font-semibold flex-shrink-0 mt-0.5 ${dark ? "text-emerald-500" : "text-stone-300"}`}>
                        {dark ? "→" : "—"}
                      </span>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>


    <!-- ─── DIRECTORY (GATED PREVIEW) ──────────────────────────────────── -->
    <section id="directory" class="border-b border-stone-200 px-5 py-24 lg:px-8">
      <div class="mx-auto max-w-7xl">

        <div class="mb-14 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-stone-400">
              Graduate directory
            </p>
            <h2 class="font-display mt-5 text-5xl font-semibold tracking-tight text-stone-950 lg:text-6xl">
              By industry vertical.
            </h2>
            <p class="mt-5 max-w-xl text-base leading-8 text-stone-500">
              Every company listed has completed a Forward engagement and documented at least one measurable business outcome. Full contact details and warm introductions are available to verified graduates only.
            </p>
          </div>
          <div class="border border-emerald-200 bg-emerald-50 px-5 py-3 self-start">
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-emerald-700">Access required</p>
            <p class="mt-1 text-xs text-emerald-800">Forward graduates only</p>
          </div>
        </div>

        <!-- Directory grid -->
        <div class="space-y-2">
          {verticals.map(({ label, count, companies }) => (
            <details class="group border border-stone-200 bg-white">
              <summary class="flex cursor-pointer select-none items-center justify-between px-8 py-5 transition-colors hover:bg-stone-50">
                <div class="flex items-center gap-6">
                  <span class="font-display text-base font-semibold text-stone-950">{label}</span>
                  <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-stone-400">
                    {count} {count === 1 ? "graduate" : "graduates"}
                  </span>
                </div>
                <svg class="h-4 w-4 text-stone-400 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M6 9l6 6 6-6"/>
                </svg>
              </summary>

              <div class="border-t border-stone-100">
                <div class="divide-y divide-stone-100">
                  {companies.map(({ name, role, size, outcome }, i) => (
                    <div class="grid gap-4 px-8 py-5 lg:grid-cols-[2fr_1fr_1fr_2fr_auto]">
                      <div>
                        <p class="font-display text-sm font-semibold text-stone-950">{name}</p>
                        <p class="mt-0.5 text-xs text-stone-400">{role}</p>
                      </div>
                      <div class="flex items-center">
                        <span class="border border-stone-200 px-2 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-[0.15em] text-stone-400">
                          {size}
                        </span>
                      </div>
                      <div class="flex items-center">
                        <span class="font-mono text-[9px] font-semibold uppercase tracking-[0.15em] text-emerald-700">
                          Verified
                        </span>
                      </div>
                      <div class="flex items-center">
                        <p class="text-sm text-stone-500">{outcome}</p>
                      </div>
                      <div class="flex items-center">
                        <span class="cursor-not-allowed font-mono text-[9px] font-semibold uppercase tracking-[0.15em] text-stone-300 line-through">
                          Connect
                        </span>
                      </div>
                    </div>
                  ))}
                </div>

                <!-- Gate overlay -->
                <div class="relative border-t border-stone-100 bg-stone-50 px-8 py-6">
                  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <p class="text-sm leading-6 text-stone-500">
                      Full profiles, contact details, and warm introductions are visible to verified Forward graduates.
                    </p>
                    <a
                      href="#access"
                      class="inline-flex flex-shrink-0 items-center gap-2 border border-stone-950 bg-stone-950 px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-stone-800"
                    >
                      Request access
                      <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </a>
                  </div>
                </div>
              </div>
            </details>
          ))}
        </div>

      </div>
    </section>


    <!-- ─── HOW THE NETWORK WORKS ─────────────────────────────────────── -->
    <section class="bg-stone-950 px-5 py-24 lg:px-8">
      <div class="mx-auto max-w-7xl">

        <div class="mb-16 max-w-3xl">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-stone-500">
            How it works
          </p>
          <h2 class="font-display mt-5 text-5xl font-semibold leading-[1.08] tracking-tight text-white lg:text-6xl">
            Built on verified outcomes, not just brand recognition.
          </h2>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-400">
            Every company in the directory went through the same week you did. They've measured the same kinds of metrics. They've made the same operational shifts. That's not a credential. That's a shared baseline.
          </p>
        </div>

        <div class="grid gap-px sm:grid-cols-3">
          {[
            {
              step: "01",
              title: "Graduate and get listed.",
              body: "When you complete a Forward engagement with documented outcomes, you're eligible to be added to the directory. We write your listing together.",
            },
            {
              step: "02",
              title: "Browse by vertical.",
              body: "Verified graduates can browse full profiles, see outcomes, and request a warm introduction through Forward. No cold outreach. No blind connections.",
            },
            {
              step: "03",
              title: "Connect with context.",
              body: "Every introduction comes with shared context. Both sides already know what Forward is, what it produced, and what to expect from the other party.",
            },
          ].map(({ step, title, body }) => (
            <div class="bg-stone-950 p-10">
              <p class="font-mono text-[11px] font-bold uppercase tracking-[0.22em] text-stone-600">{step}</p>
              <h3 class="font-display mt-5 text-xl font-semibold text-white">{title}</h3>
              <p class="mt-4 text-sm leading-7 text-stone-400">{body}</p>
            </div>
          ))}
        </div>

      </div>
    </section>


    <!-- ─── ACCESS GATE ───────────────────────────────────────────────── -->
    <section id="access" class="border-b border-stone-200 px-5 py-24 lg:px-8">
      <div class="mx-auto max-w-7xl">

        <div class="grid gap-16 lg:grid-cols-[1fr_480px]">

          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-stone-400">
              Graduate access
            </p>
            <h2 class="font-display mt-5 text-5xl font-semibold leading-[1.08] tracking-tight text-stone-950 lg:text-6xl">
              Already a Forward graduate?
            </h2>
            <p class="mt-6 max-w-lg text-base leading-8 text-stone-500">
              If you've completed a Forward engagement, request access below. We'll verify your engagement record and unlock the full directory within one business day.
            </p>
            <p class="mt-4 max-w-lg text-base leading-8 text-stone-500">
              If you haven't gone through Forward yet, this is one more reason to. The network compounds — the more graduates who work together, the less time everyone spends on evaluations that go nowhere.
            </p>

            <div class="mt-8 space-y-3">
              {[
                "Full profiles with outcome data",
                "Warm introductions facilitated by Forward",
                "Add your own company to the directory",
                "Access to future alumni events and roundtables",
              ].map((item) => (
                <div class="flex items-start gap-3">
                  <span class="font-mono text-xs font-semibold text-emerald-700 flex-shrink-0 mt-0.5">→</span>
                  <span class="text-sm leading-6 text-stone-500">{item}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Access request form -->
          <div class="border border-stone-200 bg-stone-50 p-10">
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-stone-400">
              Request access
            </p>
            <h3 class="font-display mt-4 text-2xl font-semibold tracking-tight text-stone-950">
              Verify your graduation.
            </h3>
            <p class="mt-3 text-sm leading-6 text-stone-500">
              We'll cross-reference your email against our engagement records and send you a direct access link.
            </p>

            <form
              action="mailto:forward@teamsupport.com"
              method="get"
              enctype="text/plain"
              class="mt-8 space-y-4"
            >
              <div>
                <label class="block font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-stone-500 mb-2">
                  Your name
                </label>
                <input
                  type="text"
                  name="name"
                  placeholder="Alex Rivera"
                  class="w-full border border-stone-300 bg-white px-4 py-3 text-sm text-stone-950 placeholder-stone-300 outline-none focus:border-stone-950 transition-colors"
                />
              </div>
              <div>
                <label class="block font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-stone-500 mb-2">
                  Work email
                </label>
                <input
                  type="email"
                  name="email"
                  placeholder="you@company.com"
                  class="w-full border border-stone-300 bg-white px-4 py-3 text-sm text-stone-950 placeholder-stone-300 outline-none focus:border-stone-950 transition-colors"
                />
              </div>
              <div>
                <label class="block font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-stone-500 mb-2">
                  Company
                </label>
                <input
                  type="text"
                  name="company"
                  placeholder="Acme Corp"
                  class="w-full border border-stone-300 bg-white px-4 py-3 text-sm text-stone-950 placeholder-stone-300 outline-none focus:border-stone-950 transition-colors"
                />
              </div>
              <div>
                <label class="block font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-stone-500 mb-2">
                  Approx. engagement date
                </label>
                <input
                  type="text"
                  name="date"
                  placeholder="e.g. Summer 2025"
                  class="w-full border border-stone-300 bg-white px-4 py-3 text-sm text-stone-950 placeholder-stone-300 outline-none focus:border-stone-950 transition-colors"
                />
              </div>
              <button
                type="submit"
                class="mt-2 inline-flex w-full items-center justify-center gap-2 border border-stone-950 bg-stone-950 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-stone-800"
              >
                Request access
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </button>
            </form>

            <p class="mt-5 text-xs leading-5 text-stone-400">
              Not a graduate yet? <a href="/#pricing" class="underline underline-offset-2 hover:text-stone-600 transition-colors">Reserve a Forward slot.</a>
            </p>
          </div>

        </div>

      </div>
    </section>


    <!-- ─── BOTTOM CTA ────────────────────────────────────────────────── -->
    <section class="px-5 py-32 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-3xl">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-stone-400">
            The network is growing
          </p>
          <h2 class="font-display mt-5 text-7xl font-bold leading-[0.95] tracking-tight text-stone-950 lg:text-9xl">
            Forward.
          </h2>
          <p class="mt-8 max-w-lg text-lg leading-8 text-stone-500">
            The fastest way to get into the network is to do the work first. The directory compounds as more graduates join.
          </p>
          <div class="mt-10 flex flex-col gap-3 sm:flex-row">
            <a
              href="/#pricing"
              class="inline-flex items-center justify-center gap-2 border border-stone-950 bg-stone-950 px-7 py-4 text-sm font-semibold text-white transition-colors hover:bg-stone-800"
            >
              Reserve a slot
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a
              href="/"
              class="inline-flex items-center justify-center gap-2 border border-stone-300 px-7 py-4 text-sm font-semibold text-stone-700 transition-colors hover:bg-stone-100"
            >
              Back to Forward
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>


  <!-- ─── FOOTER ──────────────────────────────────────────────────────────── -->
  <footer class="border-t border-stone-200">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-8 md:flex-row md:items-center md:justify-between lg:px-8">
      <p class="font-display text-sm font-semibold text-stone-950">Forward</p>
      <p class="text-xs text-stone-400">A professional services engagement by TeamSupport.</p>
      <p class="text-xs text-stone-400">&copy; 2025 TeamSupport, Inc.</p>
    </div>
  </footer>

</Layout>
