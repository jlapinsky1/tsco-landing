---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Pill from "../components/Pill.astro";
import Nav from "../components/Nav.astro";
import {
  painCards,
  features,
  industries,
  comparisons,
  beforeState,
  afterState,
  flowSteps,
  teamLayer,
} from "../data/content.js";

const pageTitle = "TeamSupport — B2B Customer Operations";
const pageDescription = "TeamSupport is the operating layer for complex customer work. When work originates from a customer, we make sure it has context, ownership, guided playbooks, escalation paths, time tracking, and a complete record of what happened.";

const btn = "inline-flex items-center justify-center rounded-2xl px-6 py-3 text-sm font-semibold transition focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2";
const btnPrimary = `${btn} bg-slate-950 text-white hover:bg-slate-800`;
const btnOutline = `${btn} border border-slate-300 bg-white text-slate-700 hover:bg-slate-50`;
const btnWhite   = `${btn} bg-white text-slate-950 hover:bg-blue-50`;
---

<Layout title={pageTitle} description={pageDescription}>
  <Nav />

  <main>

    <!-- ─── HERO ─────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden bg-[linear-gradient(135deg,#ffffff_0%,#f4f7fb_52%,#eef6ff_100%)]">
      <!-- ambient glows -->
      <div class="absolute right-[-10%] top-[-15%] h-[540px] w-[540px] rounded-full bg-blue-100/60 blur-3xl pointer-events-none"></div>
      <div class="absolute bottom-[-18%] left-[-8%] h-[440px] w-[440px] rounded-full bg-slate-200/50 blur-3xl pointer-events-none"></div>

      <div class="relative mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
        <div class="max-w-4xl">
          <Pill tone="default">B2B Customer Operations</Pill>

          <h1 class="mt-7 text-6xl font-semibold tracking-[-0.06em] text-slate-950 sm:text-7xl lg:text-8xl">
            Customer work needs<br class="hidden lg:block" /> an operating layer.
          </h1>

          <p class="mt-7 max-w-2xl text-xl leading-8 text-slate-600">
            TeamSupport helps B2B teams manage the complex work that originates from customers — with context, ownership, guided playbooks, escalation paths, time and effort tracking, and a complete record of what happened.
          </p>

          <div class="mt-9 flex flex-col gap-4 sm:flex-row">
            <a href="#layer" class={`${btnPrimary} px-7 py-4 text-base`}>
              See the customer operations layer <Icon name="arrowRight" class="ml-2 h-4 w-4" />
            </a>
            <a href="#category" class={`${btnOutline} px-7 py-4 text-base`}>
              Explore the concept
            </a>
          </div>
        </div>

        <!-- Operating layer flow diagram -->
        <div class="mt-14 overflow-x-auto">
          <div class="flex min-w-max items-center gap-0">
            {flowSteps.map((step, i) => (
              <div class="flex items-center">
                <div class={`rounded-2xl border px-5 py-3 text-sm font-semibold whitespace-nowrap shadow-sm ${step.color}`}>
                  {step.label}
                </div>
                {i < flowSteps.length - 1 && (
                  <div class="mx-2 flex items-center text-slate-400">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
                  </div>
                )}
              </div>
            ))}
          </div>
          <p class="mt-4 text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">
            The operating layer for work that starts with your customer
          </p>
        </div>

        <!-- Stat bar -->
        <div class="mt-12 max-w-3xl rounded-[1.5rem] border border-slate-200 bg-white/70 p-2 shadow-sm backdrop-blur">
          <div class="divide-y divide-slate-200 sm:grid sm:grid-cols-3 sm:divide-x sm:divide-y-0">
            <div class="p-4">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">Category</p>
              <p class="mt-2 text-sm font-medium text-slate-800">B2B Customer Operations</p>
            </div>
            <div class="p-4">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">Audience</p>
              <p class="mt-2 text-sm font-medium text-slate-800">Complex B2B operating models</p>
            </div>
            <div class="p-4">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-400">Not</p>
              <p class="mt-2 text-sm font-medium text-slate-800">A help desk. Not a project tool.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── PROBLEM ───────────────────────────────────────────────── -->
    <section id="problem" class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-blue-700">The problem</p>
          <h2 class="mt-5 text-5xl font-semibold tracking-[-0.045em] text-slate-950 lg:text-6xl">
            Customer requests do not stay in the support queue.
          </h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">
            A customer issue can quickly become a billing question, a product escalation, a service request, an implementation blocker, a warranty claim, an account risk, or an operational exception. When that work is managed across inboxes, spreadsheets, and disconnected tools, ownership breaks down.
          </p>
        </div>

        <div class="rounded-[2rem] border border-slate-200 bg-white p-3 shadow-xl shadow-slate-900/5">
          {painCards.map(([title, copy], index) => (
            <div class={`grid gap-4 rounded-3xl p-6 sm:grid-cols-[160px_1fr] ${index % 2 === 0 ? "bg-slate-50" : "bg-white"}`}>
              <div class="flex items-center gap-3">
                <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-xl bg-red-50 text-red-600">
                  <Icon name="x" class="h-4 w-4" />
                </div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">Problem 0{index + 1}</p>
              </div>
              <div>
                <h3 class="text-xl font-semibold tracking-tight text-slate-950">{title}</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">{copy}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── CATEGORY ──────────────────────────────────────────────── -->
    <section id="category" class="bg-slate-950 px-5 py-20 text-white lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="grid items-center gap-12 lg:grid-cols-[1fr_1fr]">

          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.22em] text-blue-300">Introducing a new category</p>
            <h2 class="mt-5 text-5xl font-semibold tracking-[-0.045em] lg:text-6xl">
              B2B Customer Operations
            </h2>
            <p class="mt-6 text-lg leading-8 text-slate-300">
              B2B Customer Operations is the discipline of managing the work that starts with customers and moves across internal teams. It sits between support, operations, service, billing, account management, product, and leadership — and right now, no single system owns it.
            </p>
            <p class="mt-4 text-lg leading-8 text-slate-300">
              TeamSupport is the operating layer that connects them.
            </p>
          </div>

          <!-- Team layer diagram -->
          <div class="rounded-[2rem] border border-white/10 bg-white/[0.06] p-8 shadow-2xl">
            <p class="mb-6 text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">Work flows through your entire organization</p>
            <div class="space-y-2">
              {teamLayer.map((team) => (
                <div class="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.05] px-5 py-3">
                  <div class="h-1.5 w-1.5 rounded-full bg-blue-400 flex-shrink-0"></div>
                  <span class="text-sm font-medium text-white">{team}</span>
                </div>
              ))}
            </div>
            <div class="mt-6 rounded-2xl border border-blue-500/30 bg-blue-600/20 px-5 py-4 text-center">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-300">Connected through</p>
              <p class="mt-1 text-lg font-semibold text-white">TeamSupport Customer Operations Layer</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ─── POSITIONING ───────────────────────────────────────────── -->
    <section class="mx-auto max-w-5xl px-5 py-20 text-center lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.22em] text-blue-700">How it fits</p>
      <h2 class="mt-5 text-5xl font-semibold tracking-[-0.05em] text-slate-950 lg:text-6xl">
        Not just tickets. Not just tasks.<br class="hidden sm:block" /> Customer operations.
      </h2>
      <p class="mx-auto mt-7 max-w-2xl text-xl leading-8 text-slate-600">
        TeamSupport is not a help desk. It is not a project management tool. It is the system of record for work that starts with your customers and needs to move across your entire organization.
      </p>

      <div class="mt-12 grid gap-5 text-left sm:grid-cols-3">
        {comparisons.map((c) => (
          <div class="rounded-3xl border border-slate-200 bg-white p-7 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">vs. {c.against}</p>
            <p class="mt-5 text-base leading-7 text-slate-500">{c.theirs}</p>
            <div class="my-5 h-px bg-slate-100"></div>
            <p class="text-base font-semibold leading-7 text-slate-950">{c.ours}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ─── OPERATING LAYER ───────────────────────────────────────── -->
    <section id="layer" class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
      <div class="mb-10 max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-blue-700">The operating layer</p>
        <h2 class="mt-5 text-5xl font-semibold tracking-[-0.045em] text-slate-950 lg:text-6xl">
          Every request gets what it needs to move.
        </h2>
        <p class="mt-5 text-lg leading-8 text-slate-600">
          Six capabilities that give customer work the structure, visibility, and accountability it needs to move through your organization without getting lost.
        </p>
      </div>

      <div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-xl shadow-slate-900/5">
        {features.map((f, i) => (
          <div class={`grid gap-6 border-b border-slate-100 p-7 last:border-b-0 md:grid-cols-[200px_1fr_1.8fr] md:items-center`}>
            <div class="flex items-center gap-4">
              <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-2xl bg-blue-50 text-blue-700">
                <Icon name={f.icon} class="h-5 w-5" />
              </div>
              <span class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-400">{f.label}</span>
            </div>
            <div>
              <h3 class="text-2xl font-semibold tracking-tight text-slate-950">{f.title}</h3>
            </div>
            <p class="text-sm leading-7 text-slate-600">{f.copy}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ─── WHO IT SERVES ─────────────────────────────────────────── -->
    <section id="who" class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
      <div class="mb-10 max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-blue-700">Who it serves</p>
        <h2 class="mt-5 text-5xl font-semibold tracking-[-0.045em] text-slate-950 lg:text-6xl">
          One concept. Many B2B operating models.
        </h2>
        <p class="mt-5 text-lg leading-8 text-slate-600">
          Any B2B organization where customer work is complex, cross-functional, and consequential.
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {industries.map((ind) => (
          <div class="rounded-3xl border border-slate-100 bg-white p-7 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-blue-50 text-blue-700">
              <Icon name={ind.icon} class="h-5 w-5" />
            </div>
            <h3 class="mt-5 text-lg font-semibold tracking-tight text-slate-950">{ind.label}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">{ind.copy}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ─── AI SECTION ────────────────────────────────────────────── -->
    <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
      <div class="grid items-center gap-12 rounded-[2rem] bg-white p-8 shadow-xl shadow-slate-900/5 lg:grid-cols-[1fr_1fr] lg:p-12">

        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-blue-700">AI and agents</p>
          <h2 class="mt-5 text-5xl font-semibold tracking-[-0.045em] text-slate-950 lg:text-6xl">
            AI can move faster when customer work has structure.
          </h2>
          <p class="mt-6 text-lg leading-8 text-slate-600">
            AI agents can retrieve data, summarize history, draft responses, update tools, and trigger actions. But companies still need a governed place where customer work is owned, tracked, escalated, measured, and remembered.
          </p>
          <p class="mt-4 text-lg leading-8 text-slate-600">
            TeamSupport gives AI the operational structure to act inside.
          </p>
        </div>

        <div class="space-y-4">
          <div class="rounded-3xl border border-slate-100 bg-slate-50 p-6">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-2xl bg-blue-50 text-blue-700">
                <Icon name="zap" class="h-5 w-5" />
              </div>
              <div>
                <h3 class="font-semibold text-slate-950">AI agents execute. TeamSupport governs.</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">Claude and MCP servers can connect tools and automate tasks. TeamSupport is the system of record where customer work is structured, owned, audited, and remembered.</p>
              </div>
            </div>
          </div>
          <div class="rounded-3xl border border-blue-100 bg-blue-50 p-6">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-700">Key distinction</p>
            <p class="mt-3 text-xl font-semibold text-slate-950">
              MCP connects the tools.<br />TeamSupport governs the customer work.
            </p>
          </div>
          <div class="rounded-3xl border border-slate-100 bg-slate-50 p-6">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-2xl bg-blue-50 text-blue-700">
                <Icon name="gitBranch" class="h-5 w-5" />
              </div>
              <div>
                <h3 class="font-semibold text-slate-950">Structure AI can act inside</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">When customer work has context, ownership, and a durable record, AI has the structure it needs to operate reliably — not just quickly.</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ─── BEFORE / AFTER ────────────────────────────────────────── -->
    <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
      <div class="mb-10 max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-blue-700">Outcomes</p>
        <h2 class="mt-5 text-5xl font-semibold tracking-[-0.045em] text-slate-950 lg:text-6xl">
          From customer chaos to accountable work.
        </h2>
      </div>

      <div class="grid gap-5 lg:grid-cols-2">
        <!-- Before -->
        <div class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm">
          <div class="mb-6 flex items-center gap-3">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-red-50 text-red-500">
              <Icon name="x" class="h-4 w-4" />
            </div>
            <p class="font-semibold text-slate-950">Without an operating layer</p>
          </div>
          <div class="space-y-3">
            {beforeState.map((item) => (
              <div class="flex items-start gap-3 rounded-2xl bg-slate-50 px-5 py-4">
                <Icon name="x" class="mt-0.5 h-4 w-4 flex-shrink-0 text-red-400" />
                <p class="text-sm leading-6 text-slate-600">{item}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- After -->
        <div class="rounded-[2rem] border border-blue-100 bg-blue-50 p-8 shadow-sm">
          <div class="mb-6 flex items-center gap-3">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-600 text-white">
              <Icon name="check" class="h-4 w-4" />
            </div>
            <p class="font-semibold text-slate-950">With TeamSupport</p>
          </div>
          <div class="space-y-3">
            {afterState.map((item) => (
              <div class="flex items-start gap-3 rounded-2xl bg-white px-5 py-4 shadow-sm">
                <Icon name="check" class="mt-0.5 h-4 w-4 flex-shrink-0 text-blue-600" />
                <p class="text-sm leading-6 text-slate-700">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ─── FINAL CTA ──────────────────────────────────────────────── -->
    <section id="demo" class="px-5 pb-20 pt-10 lg:px-8">
      <div class="mx-auto max-w-7xl overflow-hidden rounded-[2.5rem] bg-slate-950 px-8 py-16 text-center text-white shadow-2xl shadow-slate-900/20 lg:px-20">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-blue-300">Get started</p>
        <h2 class="mx-auto mt-5 max-w-4xl text-5xl font-semibold tracking-[-0.05em] lg:text-7xl">
          Build an operating layer for the work your customers create.
        </h2>
        <p class="mx-auto mt-7 max-w-2xl text-lg leading-8 text-slate-300">
          See how TeamSupport helps B2B companies manage complex customer work across teams, systems, and accounts.
        </p>
        <div class="mt-9 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <a href="mailto:demo@teamsupport.com" class={`${btnWhite} px-8 py-4 text-base`}>
            Request a demo <Icon name="arrowRight" class="ml-2 h-4 w-4" />
          </a>
        </div>
      </div>
    </section>

  </main>

  <footer class="border-t border-slate-200 bg-white">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-8 text-sm text-slate-500 md:flex-row md:items-center md:justify-between lg:px-8">
      <p class="font-semibold text-slate-950">TeamSupport</p>
      <p>The operating layer for B2B customer work.</p>
      <p>Context. Ownership. Process. Proof.</p>
    </div>
  </footer>

</Layout>
