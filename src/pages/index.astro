---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import { teamRoles, weekDays, tiers, outcomes, proofPoints } from "../data/content.js";
---

<Layout
  title="Forward — A Focused Week to Value"
  description="Forward is a high-touch professional services engagement. Book a focused week with a cross-functional team of database, AI prompting, and customer service workflow experts to move from friction to measurable value."
>
  <Nav />

  <main class="pt-[57px]">

    <!-- ─── HERO ────────────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden border-b border-stone-200 bg-stone-50">
      <div class="absolute inset-0 grid-bg pointer-events-none"></div>

      <div class="relative mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
        <div class="grid items-center gap-16 lg:grid-cols-[1fr_480px] xl:grid-cols-[1fr_560px]">

          <!-- Text -->
          <div class="max-w-2xl">
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-stone-400">
              Professional Services Engagement
            </p>

            <h1 class="font-display mt-6 text-5xl font-semibold leading-[1.05] tracking-tight text-stone-950 sm:text-6xl lg:text-[4.25rem]">
              Move from AI ambition to value in one focused week.
            </h1>

            <p class="mt-6 max-w-xl text-lg leading-8 text-stone-500">
              Forward pairs your team with a cross-functional group of database, AI prompting, and customer service workflow experts. In one week, we uncover your highest-value use cases, build against real constraints, and leave you with a validated path forward.
            </p>

            <div class="mt-9 flex flex-col gap-3 sm:flex-row">
              <a
                href="#pricing"
                class="inline-flex items-center justify-center gap-2 border border-stone-950 bg-stone-950 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-stone-800"
              >
                Reserve a Forward slot
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
              <a
                href="#what"
                class="inline-flex items-center justify-center gap-2 border border-stone-300 bg-white px-6 py-3.5 text-sm font-semibold text-stone-700 transition-colors hover:bg-stone-50"
              >
                See engagement options
              </a>
            </div>
          </div>

          <!-- Deployment Grid Visual -->
          <div class="w-full overflow-x-auto">
            <div class="min-w-[340px] border border-stone-200 bg-white shadow-sm">

              <!-- Header bar -->
              <div class="flex items-center justify-between border-b border-stone-100 bg-stone-50 px-4 py-2.5">
                <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-stone-400">
                  Forward / Week 01
                </span>
                <span class="flex items-center gap-1.5 font-mono text-[10px] font-semibold text-emerald-700">
                  <span class="relative flex h-2 w-2" aria-hidden="true">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-50"></span>
                    <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-600"></span>
                  </span>
                  ACTIVE
                </span>
              </div>

              <!-- Five-day columns -->
              <div class="grid grid-cols-5 divide-x divide-stone-100">
                {weekDays.map((day) => (
                  <div class="group flex flex-col gap-2.5 p-3 transition-colors hover:bg-stone-50">
                    <div>
                      <div class="font-mono text-2xl font-bold leading-none text-stone-100 transition-colors group-hover:text-emerald-100">
                        {day.day}
                      </div>
                      <div class="mt-1 font-mono text-[9px] font-semibold uppercase tracking-[0.16em] text-stone-400">
                        {day.name}
                      </div>
                    </div>
                    <div class="font-mono text-[9px] font-bold uppercase tracking-[0.16em] text-emerald-700">
                      {day.focus}
                    </div>
                    <div class="flex-1 space-y-1 py-0.5">
                      {day.bars.map((w) => (
                        <div
                          class="h-px rounded-full bg-emerald-800/30 transition-all group-hover:bg-emerald-700/40"
                          style={`width: ${w}%`}
                        ></div>
                      ))}
                    </div>
                    <div class="flex flex-wrap gap-0.5">
                      {["DB", "AI", "CS", "VR"].map((role) => (
                        <span class="border border-stone-200 bg-stone-50 px-1 py-0.5 font-mono text-[8px] font-semibold uppercase tracking-wide text-stone-400 transition-colors group-hover:border-stone-300 group-hover:text-stone-500">
                          {role}
                        </span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>

              <!-- Footer stats -->
              <div class="grid grid-cols-3 divide-x divide-stone-100 border-t border-stone-100 bg-stone-50">
                {[["4", "Specialists"], ["5", "Days"], ["1", "Team"]].map(([num, label]) => (
                  <div class="px-3 py-2.5 text-center">
                    <div class="font-display text-lg font-bold text-stone-950">{num}</div>
                    <div class="font-mono text-[9px] font-semibold uppercase tracking-[0.16em] text-stone-400">{label}</div>
                  </div>
                ))}
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>


    <!-- ─── WHAT FORWARD IS ──────────────────────────────────────────────── -->
    <section id="what" class="bg-stone-950 px-5 py-24 lg:px-8">
      <div class="mx-auto max-w-7xl">

        <div class="mb-16 max-w-3xl">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-stone-500">
            What Forward is
          </p>
          <h2 class="font-display mt-5 text-5xl font-semibold leading-[1.08] tracking-tight text-white lg:text-6xl">
            Not a workshop.<br />Not an assessment.<br />A deployment.
          </h2>
        </div>

        <div class="gap-px-grid-dark grid sm:grid-cols-2">
          <div class="bg-stone-950 p-10">
            <p class="font-mono text-[11px] font-bold uppercase tracking-[0.22em] text-stone-600">01</p>
            <h3 class="font-display mt-5 text-xl font-semibold text-white">Focused, not scattered.</h3>
            <p class="mt-4 text-sm leading-7 text-stone-400">
              One week. One mandate. We agree on the most important problems before we arrive, and we stay focused on them. Every hour is oriented around getting you to a specific outcome.
            </p>
          </div>
          <div class="bg-stone-950 p-10">
            <p class="font-mono text-[11px] font-bold uppercase tracking-[0.22em] text-stone-600">02</p>
            <h3 class="font-display mt-5 text-xl font-semibold text-white">Embedded, not external.</h3>
            <p class="mt-4 text-sm leading-7 text-stone-400">
              The Forward team works inside your environment — with your data, your tools, your constraints. We are not observers. We are operators.
            </p>
          </div>
          <div class="bg-stone-950 p-10">
            <p class="font-mono text-[11px] font-bold uppercase tracking-[0.22em] text-stone-600">03</p>
            <h3 class="font-display mt-5 text-xl font-semibold text-white">Practical, not theoretical.</h3>
            <p class="mt-4 text-sm leading-7 text-stone-400">
              We do not produce decks full of possibilities. We configure, we build, we test, and we validate. By Friday, you have something real to show.
            </p>
          </div>
          <div class="bg-stone-950 p-10">
            <p class="font-mono text-[11px] font-bold uppercase tracking-[0.22em] text-stone-600">04</p>
            <h3 class="font-display mt-5 text-xl font-semibold text-white">Accountable, not advisory.</h3>
            <p class="mt-4 text-sm leading-7 text-stone-400">
              We take responsibility for the outcomes of the week. If a path is not working, we change course. We do not wait to be directed. We act.
            </p>
          </div>
        </div>

        <div class="mt-px border-t border-stone-800 pt-8">
          <p class="max-w-2xl text-base leading-8 text-stone-400">
            Forward is designed to close the gap between what AI can do for your business and what your business is actually getting from it — in one focused week.
          </p>
        </div>

      </div>
    </section>


    <!-- ─── THE TEAM ─────────────────────────────────────────────────────── -->
    <section id="team" class="border-b border-stone-200 px-5 py-24 lg:px-8">
      <div class="mx-auto max-w-7xl">

        <div class="mb-14 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-stone-400">
              The Forward team
            </p>
            <h2 class="font-display mt-5 text-5xl font-semibold tracking-tight text-stone-950 lg:text-6xl">
              Deployed as one unit.
            </h2>
          </div>
          <p class="max-w-xs text-sm leading-7 text-stone-500 lg:text-right">
            A cross-functional team built for this type of engagement — not generalists, not one specialist at a time.
          </p>
        </div>

        <div class="gap-px-grid grid sm:grid-cols-2 lg:grid-cols-4">
          {teamRoles.map((role) => (
            <div class="group flex flex-col bg-white p-8 transition-colors hover:bg-stone-50">
              <div class="flex items-start justify-between">
                <div class="flex h-7 w-7 items-center justify-center border border-stone-200 transition-colors group-hover:border-stone-300">
                  <span class="font-mono text-[10px] font-bold text-stone-400">{role.index}</span>
                </div>
              </div>
              <h3 class="font-display mt-8 text-lg font-semibold tracking-tight text-stone-950">
                {role.title}
              </h3>
              <p class="mt-1.5 font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-emerald-700">
                {role.discipline}
              </p>
              <p class="mt-5 flex-1 text-sm leading-6 text-stone-500">
                {role.description}
              </p>
            </div>
          ))}
        </div>

      </div>
    </section>


    <!-- ─── THE WEEK / ENGAGEMENT FLOW ──────────────────────────────────── -->
    <section id="flow" class="px-5 py-24 lg:px-8">
      <div class="mx-auto max-w-7xl">

        <div class="mb-14 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-stone-400">
              The engagement flow
            </p>
            <h2 class="font-display mt-5 text-5xl font-semibold tracking-tight text-stone-950 lg:text-6xl">
              Five days.<br />Real momentum.
            </h2>
          </div>
          <p class="max-w-xs text-sm leading-7 text-stone-500 lg:text-right">
            Every day has a purpose. Every day ends with a handoff to the next.
          </p>
        </div>

        <div class="divide-y divide-stone-100">
          {weekDays.map((day) => (
            <div class="group grid gap-6 py-10 lg:grid-cols-[220px_1fr_1fr] lg:gap-16 lg:items-start">
              <div class="flex items-center gap-5">
                <div class="font-display text-7xl font-bold leading-none text-stone-100 transition-colors group-hover:text-emerald-800/10 select-none">
                  {day.day}
                </div>
                <div>
                  <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-stone-400">
                    {day.name}
                  </p>
                  <p class="mt-0.5 font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-emerald-700">
                    {day.focus}
                  </p>
                </div>
              </div>
              <h3 class="font-display text-2xl font-semibold tracking-tight text-stone-950">
                {day.title}
              </h3>
              <p class="text-sm leading-7 text-stone-500">
                {day.description}
              </p>
            </div>
          ))}
        </div>

      </div>
    </section>


    <!-- ─── PRICING ──────────────────────────────────────────────────────── -->
    <section id="pricing" class="border-y border-stone-200 bg-stone-50 px-5 py-24 lg:px-8">
      <div class="mx-auto max-w-7xl">

        <div class="mb-14 text-center">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-stone-400">
            Engagement options
          </p>
          <h2 class="font-display mx-auto mt-5 max-w-2xl text-5xl font-semibold tracking-tight text-stone-950 lg:text-6xl">
            Choose your Forward slot.
          </h2>
          <p class="mx-auto mt-5 max-w-lg text-base leading-7 text-stone-500">
            Engagements are scheduled in advance. Slots are limited to ensure full team focus and quality for every deployment.
          </p>
        </div>

        <div class="gap-px-grid grid sm:grid-cols-3">
          {tiers.map((tier) => (
            <div class={`flex flex-col p-8 lg:p-10 ${tier.featured ? 'bg-stone-950 text-white' : 'bg-white'}`}>

              <div>
                <p class={`font-mono text-[10px] font-bold uppercase tracking-[0.22em] ${tier.featured ? 'text-emerald-400' : 'text-emerald-700'}`}>
                  {tier.name}
                </p>
                <p class={`font-display mt-2 text-xl font-semibold ${tier.featured ? 'text-white' : 'text-stone-950'}`}>
                  {tier.tagline}
                </p>
              </div>

              <div class={`my-8 border-t ${tier.featured ? 'border-stone-800' : 'border-stone-100'}`}></div>

              <div class="mb-8">
                <p class={`font-display text-4xl font-bold ${tier.featured ? 'text-white' : 'text-stone-950'}`}>
                  {tier.price}
                </p>
                <p class={`mt-1 font-mono text-[10px] font-medium uppercase tracking-[0.16em] ${tier.featured ? 'text-stone-500' : 'text-stone-400'}`}>
                  {tier.duration}
                </p>
              </div>

              <div class={`mb-6 p-4 text-sm leading-6 ${tier.featured ? 'bg-stone-900 text-stone-300' : 'bg-stone-50 text-stone-600'}`}>
                <p class={`mb-2 font-mono text-[9px] font-bold uppercase tracking-[0.2em] ${tier.featured ? 'text-stone-500' : 'text-stone-400'}`}>
                  Best for
                </p>
                {tier.fit}
              </div>

              <p class={`mb-4 font-mono text-[9px] font-bold uppercase tracking-[0.2em] ${tier.featured ? 'text-stone-500' : 'text-stone-400'}`}>
                Deliverables
              </p>
              <ul class="flex-1 space-y-2.5">
                {tier.deliverables.map((d) => (
                  <li class="flex items-start gap-3 text-sm leading-6">
                    <svg
                      class={`mt-0.5 h-3.5 w-3.5 flex-shrink-0 ${tier.featured ? 'text-emerald-400' : 'text-emerald-700'}`}
                      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"
                    >
                      <path d="M5 12h14M13 6l6 6-6 6"/>
                    </svg>
                    <span class={tier.featured ? 'text-stone-300' : 'text-stone-600'}>{d}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-8">
                <p class={`mb-4 font-mono text-[10px] font-medium uppercase tracking-[0.14em] ${tier.featured ? 'text-stone-500' : 'text-stone-400'}`}>
                  {tier.experts}
                </p>
                <a
                  href="mailto:forward@teamsupport.com"
                  class={`inline-flex w-full items-center justify-center gap-2 border px-5 py-3 text-sm font-semibold transition-colors ${
                    tier.featured
                      ? 'border-emerald-600 bg-emerald-600 text-white hover:bg-emerald-500 hover:border-emerald-500'
                      : 'border-stone-900 bg-stone-950 text-white hover:bg-stone-800'
                  }`}
                >
                  {tier.cta}
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6"/>
                  </svg>
                </a>
              </div>

            </div>
          ))}
        </div>

      </div>
    </section>


    <!-- ─── OUTCOMES ─────────────────────────────────────────────────────── -->
    <section id="outcomes" class="px-5 py-24 lg:px-8">
      <div class="mx-auto max-w-7xl">

        <div class="mb-14 grid gap-8 lg:grid-cols-2 lg:items-end">
          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-stone-400">
              What you leave with
            </p>
            <h2 class="font-display mt-5 text-5xl font-semibold tracking-tight text-stone-950 lg:text-6xl">
              Concrete outcomes.<br />Not slide decks.
            </h2>
          </div>
          <p class="max-w-sm text-sm leading-7 text-stone-500 lg:text-right">
            Every Forward engagement ends with deliverables you can act on — not a report that sits in a folder.
          </p>
        </div>

        <div class="gap-px-grid grid sm:grid-cols-2 lg:grid-cols-3">
          {outcomes.map((outcome) => (
            <div class="group bg-white p-8 transition-colors hover:bg-stone-50">
              <p class="font-mono text-[10px] font-bold text-stone-200 transition-colors group-hover:text-stone-300">
                {outcome.index}
              </p>
              <h3 class="font-display mt-5 text-xl font-semibold tracking-tight text-stone-950">
                {outcome.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-stone-500">
                {outcome.description}
              </p>
            </div>
          ))}
        </div>

      </div>
    </section>


    <!-- ─── CREDIBILITY ──────────────────────────────────────────────────── -->
    <section class="border-y border-stone-900 bg-stone-950 px-5 py-24 lg:px-8">
      <div class="mx-auto max-w-7xl">

        <div class="mb-14 grid gap-8 lg:grid-cols-2 lg:items-end">
          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-stone-600">
              Why Forward works
            </p>
            <h2 class="font-display mt-5 text-4xl font-semibold tracking-tight text-white lg:text-5xl">
              Built for real operations.<br />Led by practitioners.
            </h2>
          </div>
          <p class="max-w-xs text-sm leading-7 text-stone-500 lg:text-right">
            Forward is not generic consulting. The team is selected for this type of engagement specifically.
          </p>
        </div>

        <div class="gap-px-grid-dark grid sm:grid-cols-2">
          {proofPoints.map((point) => (
            <div class="flex items-start gap-6 bg-stone-950 p-8">
              <span class="font-mono text-sm font-semibold text-stone-700 mt-0.5 flex-shrink-0">→</span>
              <div>
                <p class="font-display text-base font-semibold text-white">{point.label}</p>
                <p class="mt-3 text-sm leading-7 text-stone-400">{point.copy}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-px border-t border-stone-800 pt-8">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-stone-600">
            Forward engagements are capped. We limit concurrent deployments to maintain full team presence and quality.
          </p>
        </div>

      </div>
    </section>


    <!-- ─── FINAL CTA ─────────────────────────────────────────────────────── -->
    <section id="book" class="px-5 py-32 lg:px-8">
      <div class="mx-auto max-w-7xl">

        <div class="grid gap-16 lg:grid-cols-[1fr_auto] lg:items-center">

          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-stone-400">
              Book your week
            </p>
            <h2 class="font-display mt-5 text-7xl font-bold tracking-tight text-stone-950 leading-[0.95] lg:text-9xl">
              Forward.
            </h2>
            <p class="mt-8 max-w-lg text-lg leading-8 text-stone-500">
              Bring us your highest-friction workflow.<br />
              Leave with a validated path to value.
            </p>
            <div class="mt-10 flex flex-col gap-3 sm:flex-row">
              <a
                href="mailto:forward@teamsupport.com"
                class="inline-flex items-center justify-center gap-2 border border-stone-950 bg-stone-950 px-7 py-4 text-sm font-semibold text-white transition-colors hover:bg-stone-800"
              >
                Book your Forward week
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
              <a
                href="#pricing"
                class="inline-flex items-center justify-center gap-2 border border-stone-300 px-7 py-4 text-sm font-semibold text-stone-700 transition-colors hover:bg-stone-100"
              >
                View engagement options
              </a>
            </div>
          </div>

          <!-- Side stat block -->
          <div class="border border-stone-200 bg-stone-50 p-8 lg:w-56">
            <div class="font-display text-8xl font-bold leading-none text-stone-100">5</div>
            <div class="mt-2 font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-stone-400">Days</div>
            <div class="my-7 h-px bg-stone-200"></div>
            <div class="font-display text-8xl font-bold leading-none text-stone-100">4</div>
            <div class="mt-2 font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-stone-400">Specialists</div>
            <div class="my-7 h-px bg-stone-200"></div>
            <p class="text-xs leading-6 text-stone-400">
              Most teams spend months circling the same friction points. One Forward week cuts through it.
            </p>
          </div>

        </div>

      </div>
    </section>

  </main>


  <!-- ─── FOOTER ──────────────────────────────────────────────────────────── -->
  <footer class="border-t border-stone-200">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-8 md:flex-row md:items-center md:justify-between lg:px-8">
      <p class="font-display text-sm font-semibold text-stone-950">Forward</p>
      <p class="text-xs text-stone-400">A professional services engagement by TeamSupport.</p>
      <p class="text-xs text-stone-400">&copy; 2025 TeamSupport, Inc.</p>
    </div>
  </footer>

</Layout>
