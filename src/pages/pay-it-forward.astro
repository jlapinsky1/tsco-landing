---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
---

<Layout
  title="Pay it Forward — Forward by TeamSupport"
  description="Teams that complete the Summer AI Intensive and see measurable business impact may nominate another company for the program. If that company enrolls, your fee is credited back to you."
>
  <Nav />

  <main class="pt-[57px]">

    <!-- ─── HERO ────────────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden border-b border-stone-200 bg-stone-50">
      <div class="absolute inset-0 grid-bg pointer-events-none"></div>

      <div class="relative mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
        <div class="max-w-3xl">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-stone-400">
            Forward / Pay it Forward
          </p>

          <h1 class="font-display mt-6 text-5xl font-semibold leading-[1.05] tracking-tight text-stone-950 sm:text-6xl lg:text-[4.25rem]">
            You moved from curiosity to impact.<br />Now help someone else do the same.
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-500">
            Teams that complete the Summer AI Intensive and see measurable business impact may nominate another B2B support team for the program. If that team enrolls, your intensive fee is credited back to you.
          </p>

          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a
              href="#nominate"
              class="inline-flex items-center justify-center gap-2 border border-stone-950 bg-stone-950 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-stone-800"
            >
              Nominate a team
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a
              href="#how-it-works"
              class="inline-flex items-center justify-center gap-2 border border-stone-300 bg-white px-6 py-3.5 text-sm font-semibold text-stone-700 transition-colors hover:bg-stone-50"
            >
              See how it works
            </a>
          </div>
        </div>
      </div>
    </section>


    <!-- ─── HOW IT WORKS ─────────────────────────────────────────────────── -->
    <section id="how-it-works" class="border-b border-stone-200 px-5 py-24 lg:px-8">
      <div class="mx-auto max-w-7xl">

        <div class="mb-14">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-stone-400">
            How it works
          </p>
          <h2 class="font-display mt-5 text-5xl font-semibold tracking-tight text-stone-950 lg:text-6xl">
            Three steps.<br />One simple idea.
          </h2>
        </div>

        <div class="divide-y divide-stone-100">

          <div class="group grid gap-6 py-10 lg:grid-cols-[220px_1fr_1fr] lg:gap-16 lg:items-start">
            <div class="flex items-center gap-5">
              <div class="font-display text-7xl font-bold leading-none text-stone-100 transition-colors group-hover:text-emerald-800/10 select-none">
                01
              </div>
              <div>
                <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-stone-400">Step one</p>
                <p class="mt-0.5 font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-emerald-700">COMPLETE</p>
              </div>
            </div>
            <h3 class="font-display text-2xl font-semibold tracking-tight text-stone-950">
              Complete the Summer AI Intensive and show measurable impact.
            </h3>
            <p class="text-sm leading-7 text-stone-500">
              Finish the week and demonstrate that the work moved the needle on a real business metric — deflection rate, resolution time, agent efficiency, or another outcome we agreed to track at the start of the engagement.
            </p>
          </div>

          <div class="group grid gap-6 py-10 lg:grid-cols-[220px_1fr_1fr] lg:gap-16 lg:items-start">
            <div class="flex items-center gap-5">
              <div class="font-display text-7xl font-bold leading-none text-stone-100 transition-colors group-hover:text-emerald-800/10 select-none">
                02
              </div>
              <div>
                <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-stone-400">Step two</p>
                <p class="mt-0.5 font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-emerald-700">NOMINATE</p>
              </div>
            </div>
            <h3 class="font-display text-2xl font-semibold tracking-tight text-stone-950">
              Nominate a B2B support team you believe is ready to do the same.
            </h3>
            <p class="text-sm leading-7 text-stone-500">
              Think about teams that are stuck in the AI curiosity phase — evaluating tools, running pilots that go nowhere, or dealing with the same operational friction you had before Forward. Your nomination tells us they're worth a conversation.
            </p>
          </div>

          <div class="group grid gap-6 py-10 lg:grid-cols-[220px_1fr_1fr] lg:gap-16 lg:items-start">
            <div class="flex items-center gap-5">
              <div class="font-display text-7xl font-bold leading-none text-stone-100 transition-colors group-hover:text-emerald-800/10 select-none">
                03
              </div>
              <div>
                <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-stone-400">Step three</p>
                <p class="mt-0.5 font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-emerald-700">CREDIT</p>
              </div>
            </div>
            <h3 class="font-display text-2xl font-semibold tracking-tight text-stone-950">
              If they enroll, your $2,500 fee is credited back to you in full.
            </h3>
            <p class="text-sm leading-7 text-stone-500">
              No partial credits, no fine print. When a team you nominate completes enrollment, you receive a full credit equal to your Forward intensive fee. One successful nomination. One full refund.
            </p>
          </div>

        </div>

      </div>
    </section>


    <!-- ─── WHY THIS EXISTS ──────────────────────────────────────────────── -->
    <section class="bg-stone-950 px-5 py-24 lg:px-8">
      <div class="mx-auto max-w-7xl">

        <div class="mb-16 max-w-3xl">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-stone-500">
            Why we built this
          </p>
          <h2 class="font-display mt-5 text-5xl font-semibold leading-[1.08] tracking-tight text-white lg:text-6xl">
            The goal is simple.
          </h2>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-400">
            Help more B2B support teams move from AI curiosity to operational impact, without months of trial-and-error.
          </p>
        </div>

        <div class="gap-px-grid-dark grid sm:grid-cols-2">
          <div class="bg-stone-950 p-10">
            <p class="font-mono text-[11px] font-bold uppercase tracking-[0.22em] text-stone-600">01</p>
            <h3 class="font-display mt-5 text-xl font-semibold text-white">Most teams are stuck in the same loop.</h3>
            <p class="mt-4 text-sm leading-7 text-stone-400">
              Vendor demos. Internal pilots. Inconclusive results. Another quarter without a clear answer. The problem isn't the technology — it's that no one is in the room helping connect AI capability to operational reality.
            </p>
          </div>
          <div class="bg-stone-950 p-10">
            <p class="font-mono text-[11px] font-bold uppercase tracking-[0.22em] text-stone-600">02</p>
            <h3 class="font-display mt-5 text-xl font-semibold text-white">Word of mouth from practitioners matters.</h3>
            <p class="mt-4 text-sm leading-7 text-stone-400">
              When someone who runs a support operation tells another support leader "this worked for us," that cuts through the noise. Your nomination carries weight a marketing message never could.
            </p>
          </div>
          <div class="bg-stone-950 p-10">
            <p class="font-mono text-[11px] font-bold uppercase tracking-[0.22em] text-stone-600">03</p>
            <h3 class="font-display mt-5 text-xl font-semibold text-white">Impact should compound, not stay contained.</h3>
            <p class="mt-4 text-sm leading-7 text-stone-400">
              Every team that moves from friction to measurable value raises the bar for what's possible in B2B support. This program is how we scale that effect beyond one week, one company at a time.
            </p>
          </div>
          <div class="bg-stone-950 p-10">
            <p class="font-mono text-[11px] font-bold uppercase tracking-[0.22em] text-stone-600">04</p>
            <h3 class="font-display mt-5 text-xl font-semibold text-white">Your credit is a signal, not a reward.</h3>
            <p class="mt-4 text-sm leading-7 text-stone-400">
              The fee credit exists because we want nominations to mean something. You're not forwarding a name — you're vouching for a team's readiness. That's worth something, and we want it to cost something too.
            </p>
          </div>
        </div>

      </div>
    </section>


    <!-- ─── ELIGIBILITY ───────────────────────────────────────────────────── -->
    <section id="eligibility" class="border-b border-stone-200 px-5 py-24 lg:px-8">
      <div class="mx-auto max-w-7xl">

        <div class="mb-14 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-stone-400">
              Eligibility
            </p>
            <h2 class="font-display mt-5 text-5xl font-semibold tracking-tight text-stone-950 lg:text-6xl">
              What qualifies.
            </h2>
          </div>
          <p class="max-w-xs text-sm leading-7 text-stone-500 lg:text-right">
            Both sides of the nomination have a bar to clear.
          </p>
        </div>

        <div class="gap-px-grid grid lg:grid-cols-2">

          <!-- Nominator -->
          <div class="bg-white p-10">
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-emerald-700">
              To nominate
            </p>
            <h3 class="font-display mt-5 text-2xl font-semibold tracking-tight text-stone-950">
              Your engagement must qualify.
            </h3>
            <p class="mt-4 text-sm leading-7 text-stone-500">
              You can nominate after your Forward week closes and at least one agreed-upon success metric has been validated. Impact doesn't have to be fully scaled — it has to be real and documented.
            </p>
            <ul class="mt-8 space-y-3">
              {[
                "Summer AI Intensive completed",
                "At least one measurable outcome validated",
                "Nomination submitted within 90 days of your engagement close",
              ].map((item) => (
                <li class="flex items-start gap-3 text-sm leading-6 text-stone-500">
                  <span class="font-mono text-xs font-semibold text-emerald-700 flex-shrink-0 mt-0.5">→</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <!-- Nominee -->
          <div class="bg-stone-50 p-10">
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-stone-500">
              To be nominated
            </p>
            <h3 class="font-display mt-5 text-2xl font-semibold tracking-tight text-stone-950">
              The team must be a real fit.
            </h3>
            <p class="mt-4 text-sm leading-7 text-stone-500">
              We'll have a discovery conversation with the nominated team. If they're not the right fit for a Forward week, we'll tell them — and you — honestly. We won't enroll a team that isn't ready.
            </p>
            <ul class="mt-8 space-y-3">
              {[
                "B2B customer support team or operations leader",
                "Active AI initiative or clear intent to start one",
                "Willing to engage in a scoping conversation",
              ].map((item) => (
                <li class="flex items-start gap-3 text-sm leading-6 text-stone-500">
                  <span class="font-mono text-xs font-semibold text-stone-400 flex-shrink-0 mt-0.5">→</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>

        </div>

        <div class="mt-px border-t border-stone-200 pt-8">
          <p class="max-w-2xl text-sm leading-7 text-stone-400">
            Credit is issued after the nominated team completes enrollment and payment. One nomination per completed engagement. Nominations are not transferable.
          </p>
        </div>

      </div>
    </section>


    <!-- ─── NOMINATE CTA ──────────────────────────────────────────────────── -->
    <section id="nominate" class="px-5 py-32 lg:px-8">
      <div class="mx-auto max-w-7xl">

        <div class="grid gap-16 lg:grid-cols-[1fr_auto] lg:items-center">

          <div>
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.24em] text-stone-400">
              Nominate a team
            </p>
            <h2 class="font-display mt-5 text-7xl font-bold tracking-tight text-stone-950 leading-[0.95] lg:text-9xl">
              Forward.
            </h2>
            <p class="mt-8 max-w-lg text-lg leading-8 text-stone-500">
              Know a support leader who's been circling the same AI friction for too long?<br />
              Send us their name.
            </p>
            <div class="mt-10 flex flex-col gap-3 sm:flex-row">
              <a
                href="mailto:forward@teamsupport.com?subject=Pay%20it%20Forward%20Nomination"
                class="inline-flex items-center justify-center gap-2 border border-stone-950 bg-stone-950 px-7 py-4 text-sm font-semibold text-white transition-colors hover:bg-stone-800"
              >
                Submit a nomination
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
              <a
                href="/"
                class="inline-flex items-center justify-center gap-2 border border-stone-300 px-7 py-4 text-sm font-semibold text-stone-700 transition-colors hover:bg-stone-100"
              >
                Back to Forward
              </a>
            </div>
          </div>

          <!-- Side callout -->
          <div class="border border-stone-200 bg-stone-50 p-8 lg:w-64">
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-stone-400">The credit</p>
            <div class="font-display mt-4 text-8xl font-bold leading-none text-stone-100">$0</div>
            <div class="mt-2 font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-stone-400">Your final fee</div>
            <div class="my-7 h-px bg-stone-200"></div>
            <p class="text-xs leading-6 text-stone-400">
              One successful nomination. One full credit. Your $2,500 Forward fee returns to you when the team you nominate enrolls.
            </p>
          </div>

        </div>

      </div>
    </section>

  </main>


  <!-- ─── FOOTER ──────────────────────────────────────────────────────────── -->
  <footer class="border-t border-stone-200">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-8 md:flex-row md:items-center md:justify-between lg:px-8">
      <p class="font-display text-sm font-semibold text-stone-950">Forward</p>
      <p class="text-xs text-stone-400">A professional services engagement by TeamSupport.</p>
      <p class="text-xs text-stone-400">&copy; 2025 TeamSupport, Inc.</p>
    </div>
  </footer>

</Layout>
