---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "TeamSupport — B2B Customer Operations",
  description = "TeamSupport is the operating layer for complex customer work. When work originates from a customer, we make sure it has context, ownership, guided playbooks, escalation paths, time tracking, and a complete record of what happened.",
  canonical,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
