        <svg class="h-3.5 w-3.5 text-white" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 1L13 4.5V9.5L7 13L1 9.5V4.5L7 1Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
