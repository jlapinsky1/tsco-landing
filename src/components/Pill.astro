---
const { tone = "default" } = Astro.props;
const tones = {
  default: "bg-blue-50 text-blue-800 border-blue-200",
  dark:    "bg-slate-900 text-white border-slate-800",
  light:   "bg-slate-100 text-slate-700 border-slate-200",
  blue:    "bg-blue-600 text-white border-blue-700",
};
---
<span class={`inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold tracking-wide ${tones[tone] ?? tones.default}`}>
  <slot />
</span>
